# Instance overlay for 'Laszlo-AgentRegistryDemo2 Agent' - loaded before .env (AGENT_ENV_FILE), so these values win.
# Start with:  .\scripts\run.ps1 -EnvFile .env.agent2
APP_PORT=8001
WEB_REDIRECT_URI=http://localhost:8001/auth/callback
AGENT365_AGENT_ID=<agent2-identity-app-id>
AGENT365_AGENT_NAME=Laszlo-AgentRegistryDemo2
AGENT365_AGENT_DESCRIPTION=Weather and geocoding agent (instance 2, same blueprint)
AGENT365_REGISTRATION_ID=<agent2-identity-app-id>
AGENT365OBSERVABILITY__AGENTID=<agent2-identity-app-id>
AGENT365OBSERVABILITY__AGENTNAME=Laszlo-AgentRegistryDemo2
AGENT365OBSERVABILITY__AGENTDESCRIPTION=Weather and geocoding agent (instance 2, same blueprint)

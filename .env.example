# Copy to .env and fill in. NEVER commit .env.

# ── Web app ─────────────────────────────────────────────────────────────────
APP_HOST=localhost
APP_PORT=8000
SESSION_SECRET=change-me-to-a-long-random-string

# Set to false for a "no tenant" smoke test (step 01). Set true once registered.
AUTH_ENABLED=false

# ── LLM provider ────────────────────────────────────────────────────────────
# ollama  -> local model (default, free, offline)
# github  -> GitHub Models free tier (needs GITHUB_TOKEN with models:read)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_TOKEN=

# ── Entra / Agent 365 (filled from a365.generated.config.json + scripts\Configure-Entra.ps1) ──
AGENT365_TENANT_ID=
AGENT365_AGENT_NAME=Laszlo-AgentRegistryDemo1
AGENT365_AGENT_DESCRIPTION=3rd-party LangGraph agent that returns current weather and geocodes for cities/addresses.
# Blueprint app (client) ID
AGENT365_BLUEPRINT_ID=
# Blueprint client secret (demo only — use certificate / managed identity in production)
AGENT365_BLUEPRINT_CLIENT_SECRET=
# Agent identity app ID (child of blueprint) — this is gen_ai.agent.id
AGENT365_AGENT_ID=
# Scope exposed on the blueprint that the web client requests (Tc audience = blueprint)
AGENT365_BLUEPRINT_SCOPE=api://<blueprint-app-id>/access_agent_as_user

# Web client app registration (the UI users sign into)
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=
WEB_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Observability ───────────────────────────────────────────────────────────
# true = export to Agent 365 (Defender / Purview / M365 admin center). Requires AUTH_ENABLED=true.
ENABLE_A365_OBSERVABILITY_EXPORTER=false
# Local Jaeger (OTLP/HTTP). Leave blank to disable.
OTLP_LOCAL_ENDPOINT=http://localhost:4318/v1/traces
# Print spans to console as well
OTEL_CONSOLE_EXPORTER=false
OTEL_LOG_LEVEL=INFO
A365_OBSERVABILITY_LOG_LEVEL=info|warn|error

# ── Microsoft Purview APIs (processContent / protectionScopes / contentActivities) ──
# Agent calls Purview as the agent identity OBO the user (inheritable Graph scopes on the blueprint). Needs AUTH_ENABLED=true.
PURVIEW_ENABLED=true
# App ID sent as applicationLocation; must match the DLP policy location. Blank = AGENT365_AGENT_ID.
PURVIEW_APP_LOCATION_ID=
# Log a metadata-only content activity when no Purview policy scopes the user.
PURVIEW_LOG_WHEN_UNSCOPED=true
# true = block the turn if an inline Purview check fails (production). false = fail open (demo).
PURVIEW_FAIL_CLOSED=false

# --- Diagnostics tab ---
# Optional scope for an MCP server the agent calls (e.g. api://<mcp-app-id>/.default). Blank = "not configured".
MCP_SCOPE=
# Read directory + Conditional Access data with the operator's `az login` Graph token (demo only).
# Every signed-in user of this localhost app can see those tenant policies. false = disable.
DIAG_ADMIN_GRAPH=true
